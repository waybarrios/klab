# Local environments, generated binaries and experiment locks
/.venv/
/.cache/
/.scratch/
/bin/
/native/build/
/rust/
__pycache__/
*.pyc
*.so
*.o
*.new

# Local agent state and implementation conversations
/.pi/
/.superpowers/
/.claude/
/docs/superpowers/
/notes/opus-*.md
