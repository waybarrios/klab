# Raw experiment history is released as a compressed evidence snapshot.
# Keep the small original configuration references needed by frozen_cases.
/results/*
!/results/adaptive-search.json
!/results/fp16-search.json
!/results/bf16-search.json
!/results/lossless-compact.json
!/results/compressed-performance-bf16-search-r2.json
!/results/compressed-performance-fp32-search-r2.json
!/results/public/

# This regression tests a machine-local background supervisor.
/tests/test_frozen_cohort_batch.py

# Agent-generated working notes and intermediate research write-ups (kept locally, not published)
/.remember/
/notes/
/docs/
/QUICKSTART.md
/ROADMAP.md
/examples/README.md
